---
config:
  layout: elk
  theme: default
  er:
    useMaxWidth: false
---
erDiagram
    direction TB

    addresses {
        integer id PK "NOT NULL"
        integer user_id FK "NOT NULL"
        varchar_150_ street  "NOT NULL"
        varchar_20_ number  "NOT NULL"
        varchar_100_ complement  "NULL"
        varchar_100_ neighborhood  "NOT NULL"
        varchar_80_ city  "NOT NULL"
        varchar_2_ state  "NOT NULL"
        varchar_10_ zip_code  "NOT NULL"
        addresses_label_enum label  "NOT NULL"
        boolean is_default  "NOT NULL"
        numeric_10_7_ latitude  "NULL"
        numeric_10_7_ longitude  "NULL"
        varchar_20_ coordinate_source  "NOT NULL"
    }

    chat_messages {
        integer id PK "NOT NULL"
        integer order_id FK "NOT NULL"
        integer sender_id FK "NOT NULL"
        integer receiver_id FK "NOT NULL"
        chat_messages_participant_type_enum participant_type  "NOT NULL"
        text message  "NOT NULL"
        timestamp sent_at  "NOT NULL"
        timestamp read_at  "NULL"
    }

    coupons {
        integer id PK "NOT NULL"
        varchar_50_ code UK "NOT NULL"
        timestamp expires_at  "NOT NULL"
        boolean active  "NOT NULL"
        timestamp created_at  "NOT NULL"
        varchar_120_ name  "NOT NULL"
        text description  "NULL"
        coupons_type_enum type  "NOT NULL"
        integer unit_id FK "NULL"
        coupons_discount_type_enum discount_type  "NOT NULL"
        numeric_10_2_ discount_amount  "NOT NULL"
        numeric_10_2_ maximum_discount  "NULL"
        numeric_10_2_ minimum_order_value  "NOT NULL"
        timestamp starts_at  "NOT NULL"
        integer total_usage_limit  "NULL"
        integer usage_limit_per_user  "NULL"
        integer current_usage_count  "NOT NULL"
        integer created_by FK "NOT NULL"
        timestamp updated_at  "NOT NULL"
    }

    delivery_persons {
        integer id PK "NOT NULL"
        integer user_id FK,UK "NOT NULL"
        delivery_persons_vehicle_enum vehicle  "NOT NULL"
        delivery_persons_status_enum status  "NOT NULL"
        numeric_3_2_ average_rating  "NULL"
        timestamp created_at  "NOT NULL"
        boolean is_online  "NOT NULL"
        timestamp availability_updated_at  "NULL"
        delivery_persons_affiliation_type_enum affiliation_type  "NOT NULL"
    }

    delivery_reviews {
        integer id PK "NOT NULL"
        integer order_id FK,UK "NOT NULL"
        integer client_id FK "NOT NULL"
        integer delivery_person_id FK "NOT NULL"
        integer rating  "NOT NULL"
        text comment  "NULL"
        timestamp created_at  "NOT NULL"
    }

    order_items {
        integer id PK "NOT NULL"
        integer order_id FK "NOT NULL"
        integer product_id FK "NOT NULL"
        numeric_12_3_ quantity  "NOT NULL"
        numeric_10_2_ unit_price  "NOT NULL"
        jsonb product_snapshot  "NULL"
    }

    order_status_history {
        integer id PK "NOT NULL"
        integer order_id FK "NOT NULL"
        integer updated_by FK "NULL"
        order_status_history_status_enum status  "NOT NULL"
        timestamp created_at  "NOT NULL"
    }

    orders {
        integer id PK "NOT NULL"
        integer client_id FK "NOT NULL"
        integer unit_id FK "NOT NULL"
        integer delivery_person_id FK "NULL"
        timestamp order_date  "NOT NULL"
        orders_status_enum status  "NOT NULL"
        orders_delivery_status_enum delivery_status  "NULL"
        orders_delivery_step_enum delivery_step  "NULL"
        numeric_10_2_ total_amount  "NOT NULL"
        numeric_10_2_ subtotal  "NOT NULL"
        numeric_10_2_ discount_amount  "NOT NULL"
        numeric_10_2_ delivery_fee  "NOT NULL"
        text cancellation_reason  "NULL"
        timestamp cancelled_at  "NULL"
        orders_cancelled_by_enum cancelled_by  "NULL"
        integer address_id FK "NULL"
        integer coupon_id FK "NULL"
        timestamp scheduled_delivery_date  "NULL"
        boolean is_scheduled  "NOT NULL"
        orders_delivery_type_enum delivery_type  "NOT NULL"
        orders_payment_status_enum payment_status  "NOT NULL"
        timestamp updated_at  "NOT NULL"
        varchar_64_ pickup_code_hash  "NULL"
        varchar_64_ delivery_code_hash  "NULL"
        timestamp pickup_code_expires_at  "NULL"
        timestamp delivery_code_expires_at  "NULL"
        integer pickup_code_attempts  "NOT NULL"
        integer delivery_code_attempts  "NOT NULL"
        timestamp pickup_code_locked_until  "NULL"
        timestamp delivery_code_locked_until  "NULL"
        timestamp pickup_verified_at  "NULL"
        timestamp delivery_verified_at  "NULL"
        uuid checkout_id  "NULL"
        varchar_255_ delivery_code_ciphertext  "NULL"
        jsonb destination_snapshot  "NULL"
        uuid tracking_session_id  "NULL"
        integer tracking_consent_user_id  "NULL"
        timestamptz tracking_consent_at  "NULL"
        timestamptz tracking_revoked_at  "NULL"
        timestamptz payment_due_at  "NULL"
        numeric_12_2_ change_for  "NULL"
        varchar_64_ checkout_request_hash  "NULL"
    }

    payment_transactions {
        varchar_80_ id PK "NOT NULL"
        integer unit_id FK "NOT NULL"
        varchar_100_ reference  "NOT NULL"
        varchar_30_ status  "NOT NULL"
        numeric_12_2_ amount  "NOT NULL"
        numeric_12_2_ refunded_amount  "NOT NULL"
        timestamptz provider_updated_at  "NULL"
        timestamptz updated_at  "NOT NULL"
    }

    payments {
        integer id PK "NOT NULL"
        integer order_id FK,UK "NOT NULL"
        payments_method_enum method  "NULL"
        payments_status_enum status  "NOT NULL"
        timestamptz payment_date  "NULL"
        varchar_40_ transaction_id  "NULL"
        varchar_120_ mp_preference_id  "NULL"
        varchar_60_ mp_status_detail  "NULL"
        timestamp mp_last_event_at  "NULL"
        timestamp created_at  "NOT NULL"
        timestamp updated_at  "NOT NULL"
        varchar_500_ mp_checkout_url  "NULL"
        numeric_12_2_ refunded_amount  "NOT NULL"
        numeric_12_2_ fee_amount  "NOT NULL"
        varchar_30_ refund_status  "NULL"
        timestamptz reconcile_after  "NOT NULL"
        integer received_by  "NULL"
        varchar_200_ receipt_reference  "NULL"
        varchar_100_ payment_reference  "NULL"
    }

    products {
        integer id PK "NOT NULL"
        varchar_150_ name  "NOT NULL"
        text description  "NULL"
        numeric_10_2_ price  "NOT NULL"
        varchar_50_ unit_of_measure  "NOT NULL"
        boolean active  "NOT NULL"
        integer unit_id FK "NOT NULL"
        integer category_id FK "NOT NULL"
        varchar_100_ brand  "NULL"
        varchar image_url  "NULL"
    }

    reviews {
        integer id PK "NOT NULL"
        integer order_id FK "NOT NULL"
        integer client_id FK "NOT NULL"
        integer unit_id FK "NOT NULL"
        integer product_id FK "NULL"
        integer rating  "NOT NULL"
        text comment  "NULL"
        timestamp created_at  "NOT NULL"
    }

    units {
        integer id PK "NOT NULL"
        varchar_100_ name  "NOT NULL"
        varchar_14_ cnpj UK "NOT NULL"
        varchar_80_ city  "NOT NULL"
        varchar_10_ zip_code  "NOT NULL"
        varchar_2_ state  "NOT NULL"
        integer admin_id FK "NOT NULL"
        timestamp created_at  "NOT NULL"
        varchar_150_ street  "NULL"
        varchar_20_ number  "NULL"
        varchar_100_ complement  "NULL"
        varchar_80_ neighborhood  "NULL"
        numeric_10_7_ latitude  "NULL"
        numeric_10_7_ longitude  "NULL"
        varchar image_url  "NULL"
        varchar cover_url  "NULL"
        varchar_20_ coordinate_source  "NOT NULL"
        numeric_7_2_ delivery_radius_km  "NOT NULL"
        integer scheduling_slot_minutes  "NULL"
        integer scheduling_capacity  "NULL"
        jsonb gallery_urls  "NOT NULL"
        boolean is_active  "NOT NULL"
    }

    users {
        integer id PK "NOT NULL"
        varchar_100_ name  "NULL"
        varchar email UK "NOT NULL"
        varchar cpf  "NULL"
        varchar password_hash  "NULL"
        users_global_role_enum global_role  "NOT NULL"
        users_app_profile_enum app_profile  "NULL"
        integer failed_login_attempts  "NOT NULL"
        timestamp locked_until  "NULL"
        boolean email_verified  "NOT NULL"
        varchar email_verification_token  "NULL"
        varchar password_reset_token  "NULL"
        timestamp password_reset_expires_at  "NULL"
        timestamp created_at  "NOT NULL"
        varchar avatar_url  "NULL"
        varchar firebase_uid  "NULL"
        varchar phone  "NULL"
        boolean profile_complete  "NOT NULL"
        boolean is_active  "NOT NULL"
        varchar_64_ cpf_hash UK "NULL"
        varchar_64_ phone_hash UK "NULL"
    }

    orders ||--o{ chat_messages : "order_id"
    users ||--o{ chat_messages : "receiver_id"
    users ||--o{ chat_messages : "sender_id"
    users ||--o{ delivery_reviews : "client_id"
    delivery_persons ||--o{ delivery_reviews : "delivery_person_id"
    orders ||--o| delivery_reviews : "order_id"
    orders ||--o{ order_items : "order_id"
    products ||--o{ order_items : "product_id"
    orders ||--o{ order_status_history : "order_id"
    users o|--o{ order_status_history : "updated_by"
    addresses o|--o{ orders : "address_id"
    users ||--o{ orders : "client_id"
    coupons o|--o{ orders : "coupon_id"
    delivery_persons o|--o{ orders : "delivery_person_id"
    units ||--o{ orders : "unit_id"
    orders ||--o| payments : "order_id"
    users ||--o{ reviews : "client_id"
    orders ||--o{ reviews : "order_id"
    products o|--o{ reviews : "product_id"
    units ||--o{ reviews : "unit_id"
    users |o..o{ orders : "ref tracking_consent_user_id sem FK"
    users |o..o{ payments : "ref received_by sem FK"
    payment_transactions |o..o{ payments : "ref transaction_id sem FK"
